                        }
                    }
                },
                {
                    "name": "Login Teacher",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Login successful\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// Save token for subsequent requests",
                                    "pm.environment.set(\"teacher_token\", pm.response.text().replace(/\"/g, ''));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
