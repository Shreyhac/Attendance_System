        {
            "name": "2. Setup - Create Subject",
            "item": [
                {
                    "name": "Create Mathematics Subject",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Subject created\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "var jsonData = pm.response.json();",
                                    "pm.environment.set(\"subject_id\", jsonData.id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{teacher_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Mathematics\",\n  \"teacherEmail\": \"teacher@example.com\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:8081/api/teacher/subject",
